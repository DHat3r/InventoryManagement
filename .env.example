# Inventory Management - Environment Variables
# Copia este archivo a .env y ajusta los valores

# PostgreSQL
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT
JWT_SECRET=InventoryManagement-SuperSecretKey-2024-MustBeAtLeast32Chars!
JWT_ISSUER=InventoryManagement.Api
JWT_AUDIENCE=InventoryManagement.Client
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Admin Seed
ADMIN_USERNAME=admin
ADMIN_RUT=765432105
ADMIN_FULL_NAME=Administrador del Sistema
ADMIN_PASSWORD=Admin123!
ADMIN_ROTATE_ON_STARTUP=true
ADMIN_RUN_ON_STARTUP=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:3000

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080